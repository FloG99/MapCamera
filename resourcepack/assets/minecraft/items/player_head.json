{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "mapcamera:digital",
        "model": {
          "type": "minecraft:model",
          "model": "mapcamera:item/digital"
        }
      },
      {
        "when": "mapcamera:polaroid",
        "model": {
          "type": "minecraft:model",
          "model": "mapcamera:item/polaroid"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "minecraft:item/template_skull",
      "model": {
        "type": "minecraft:player_head"
      },
      "transformation": {
        "left_rotation": [
          1.0,
          0.0,
          0.0,
          -0.0
        ],
        "right_rotation": [
          0.0,
          0.0,
          0.0,
          1.0
        ],
        "scale": [
          1.0,
          1.0,
          1.0
        ],
        "translation": [
          0.5,
          0.0,
          0.5
        ]
      }
    }
  }
}
